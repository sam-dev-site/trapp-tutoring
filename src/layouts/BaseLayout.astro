---
import BrandMark from '../components/BrandMark.astro';
import MeetingButtons from '../components/MeetingButtons.astro';
import '../styles/tokens.css';
import '../styles/type.css';
import '../styles/shell.css';
import '../styles/nav.css';
import '../styles/meeting.css';
import '../styles/footer.css';

interface Props {
	title?: string;
	mainClass?: string;
	showMeeting?: boolean;
}

const { title = 'Trapp Tutoring', mainClass, showMeeting = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const faviconSrc = `${baseUrl}images/logo/whale-icon.jpg`;
const basePrefix = baseUrl.replace(/\/$/, '');
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const path =
	basePrefix && (rawPath === basePrefix || rawPath.startsWith(`${basePrefix}/`))
		? rawPath.slice(basePrefix.length) || '/'
		: rawPath;

const links = [
	{ route: '/', label: 'Home' },
	{ route: '/tutoring-with-me', label: 'Tutoring With Me' },
	{ route: '/dyslexia', label: 'Dyslexia' },
	{ route: '/barton', label: 'Barton' },
	{ route: '/login', label: 'Login' },
] as const;

function hrefFor(route: string) {
	return route === '/' ? baseUrl : `${baseUrl}${route.slice(1)}`;
}

function isCurrent(route: string) {
	if (route === '/') {
		return path === '/';
	}
	return path === route;
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/jpeg" href={faviconSrc} />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to main content</a>
		<header class="site-header">
			<BrandMark />
			<nav aria-label="Site">
				<ul class="nav-links">
					{
						links.map((link) => (
							<li>
								<a href={hrefFor(link.route)} aria-current={isCurrent(link.route) ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<a class="meeting-nav" href={showMeeting ? '#meeting' : `${baseUrl}#meeting`}>Set up a meeting</a>
		</header>
		<main id="main" class={mainClass} tabindex="-1">
			<slot />
		</main>
		{
			showMeeting && (
				<section id="meeting" class="meeting-section" aria-labelledby="meeting-heading">
					<h2 id="meeting-heading">Set up a meeting</h2>
					<MeetingButtons />
				</section>
			)
		}
		<footer class="site-footer">
			<div class="site-footer-inner">
				<BrandMark />
			</div>
		</footer>
	</body>
</html>
