---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMonogram from '../components/logo/LogoMonogram.astro';
import LogoTiles from '../components/logo/LogoTiles.astro';
import LogoWordbuild from '../components/logo/LogoWordbuild.astro';
import '../styles/logo-options.css';
---

<BaseLayout title="Logo options — Trapp Tutoring">
	<h1>Logo options</h1>
	<p>
		Three new marks for Erin to pick. None is final. The wordmark is live text, not
		inside the picture. These are not the old book-and-flowers mark.
	</p>

	<div class="logo-options">
		<article class="logo-option">
			<h2>Option A — Letter tiles</h2>
			<p>Two tiles, each with a T. Teal and coral, slightly stacked.</p>
			<div class="logo-previews">
				<div class="logo-preview">
					<LogoTiles size={96} />
					<span>Large</span>
				</div>
				<div class="logo-preview">
					<LogoTiles size={32} />
					<span>Nav (32)</span>
				</div>
				<div class="logo-preview">
					<LogoTiles size={16} />
					<span>Favicon (16)</span>
				</div>
			</div>
			<div class="logo-wordmark-row">
				<LogoTiles size={32} />
				<p>Trapp Tutoring</p>
			</div>
		</article>

		<article class="logo-option">
			<h2>Option B — Word-building</h2>
			<p>Three tiles in a step, like building a word. The middle tile holds a T.</p>
			<div class="logo-previews">
				<div class="logo-preview">
					<LogoWordbuild size={96} />
					<span>Large</span>
				</div>
				<div class="logo-preview">
					<LogoWordbuild size={32} />
					<span>Nav (32)</span>
				</div>
				<div class="logo-preview">
					<LogoWordbuild size={16} />
					<span>Favicon (16)</span>
				</div>
			</div>
			<div class="logo-wordmark-row">
				<LogoWordbuild size={32} />
				<p>Trapp Tutoring</p>
			</div>
		</article>

		<article class="logo-option">
			<h2>Option C — Monogram</h2>
			<p>A calm TT inside a rounded square. Teal bar, coral second stem.</p>
			<div class="logo-previews">
				<div class="logo-preview">
					<LogoMonogram size={96} />
					<span>Large</span>
				</div>
				<div class="logo-preview">
					<LogoMonogram size={32} />
					<span>Nav (32)</span>
				</div>
				<div class="logo-preview">
					<LogoMonogram size={16} />
					<span>Favicon (16)</span>
				</div>
			</div>
			<div class="logo-wordmark-row">
				<LogoMonogram size={32} />
				<p>Trapp Tutoring</p>
			</div>
		</article>
	</div>
</BaseLayout>
