---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import PageTitle from '../components/PageTitle.astro';
import WarningSignsGame from '../components/WarningSignsGame.astro';
import '../styles/dyslexia.css';

const resources = [
	{
		label: 'Overcoming Dyslexia – by Sally Shaywitz, M.D.',
		href: 'https://www.amazon.com/dp/B00IIB2N80',
		blurb: 'The book many families start with: what dyslexia is, and what help actually looks like.',
	},
	{
		label: 'Barton Reading & Spelling System',
		href: 'https://bartonreading.com/',
		blurb: 'The official site for the tutoring program Erin uses, including how the ten levels work.',
	},
	{
		label: 'Bright Solutions for Dyslexia',
		href: 'https://dys-add.com/',
		blurb: 'Susan Barton’s site — warning signs, videos, and how Barton tutoring is set up.',
	},
	{
		label: 'International Dyslexia Association',
		href: 'https://dyslexiaida.org/',
		blurb: 'Clear fact sheets, and a way to find specialists near you.',
	},
	{
		label: 'Learning Ally',
		href: 'https://learningally.org/',
		blurb: 'Audiobooks for students who qualify with a reading disability.',
	},
	{
		label: 'The Yale Center for Dyslexia and Creativity',
		href: 'https://dyslexia.yale.edu/',
		blurb: 'Plain-language research and articles from the Shaywitz team at Yale.',
	},
] as const;
---

<BaseLayout title="Dyslexia — Trapp Tutoring">
	<section class="dyslexia-hero">
		<div>
			<PageTitle text="Dyslexia" />
			<p>
				Dyslexia researchers believe that Dyslexia affects 20% of people, and many struggling
				readers are undiagnosed.
			</p>
			<p>
				Students with three or more of the warning signs are encouraged to learn more about
				Dyslexia.
			</p>
		</div>
		<ImagePlaceholder shot="tiles" />
	</section>

	<WarningSignsGame />

	<p class="dyslexia-attribution">
		These warning signs reprinted with prior written permission from Susan Barton, Founder of
		Bright Solutions for Dyslexia and developer of the Barton Reading and Spelling System®.
	</p>

	<section class="dyslexia-resources" id="dyslexia-resources" aria-labelledby="dyslexia-resources-heading">
		<h2 id="dyslexia-resources-heading">Resources</h2>
		<ul class="dyslexia-resource-list">
			{
				resources.map((resource) => (
					<li>
						<a href={resource.href}>{resource.label}</a>
						<p>{resource.blurb}</p>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
