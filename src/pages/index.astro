---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDecor from '../components/HeroDecor.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import TestimonialGallery from '../components/TestimonialGallery.astro';
import '../styles/home.css';

const heroWords = ['Reading', 'and', 'Spelling', 'Intervention'];
const aboutHref = `${import.meta.env.BASE_URL}tutoring-with-me#more-about`;
---

<BaseLayout mainClass="home-main">
	<section class="home-hero">
		<HeroDecor />
		<div class="home-hero-copy">
			<h1 class="home-hero-title">
				{
					heroWords.map((word, index) => (
						<span class="home-hero-word" style={`--word-i: ${index}`}>{word}</span>
					))
				}
			</h1>
			<a
				class="meeting-nav home-hero-meet"
				href="#meeting"
				data-meeting-open
				aria-haspopup="dialog"
				aria-controls="meeting-dialog"
			>
				Set up a meeting
			</a>
		</div>
		<div class="home-hero-art">
			<ImagePlaceholder shot="hero" showLabel={false} />
		</div>
	</section>

	<section class="home-intro" aria-labelledby="home-intro-heading">
		<h2 id="home-intro-heading">Hello! I am Erin Trapp, your literacy and dyslexia specialist.</h2>
		<div class="home-about-row">
			<ImagePlaceholder shot="about" frameTilt />
			<div class="home-about">
				<div class="home-about-body">
					<p>
						Hi, I'm Erin! I'm a
						<a href="https://bartonreading.com/" target="_blank" rel="noopener noreferrer">Barton-trained</a>
						reading interventionist who specializes in helping students with dyslexia and
						other reading challenges. Through interactive, one-on-one online lessons, I
						combine structured, research-based instruction with a positive, encouraging
						environment where students can build skills, confidence, and a love of learning.
					</p>
				</div>
				<a class="phrase-link home-about-more" href={aboutHref}>Continue reading</a>
			</div>
		</div>
	</section>

	<TestimonialGallery />
</BaseLayout>
