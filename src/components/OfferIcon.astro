---
type OfferIconName =
	| 'one-on-one'
	| 'remote'
	| 'interactive'
	| 'barton'
	| 'weekly'
	| 'fun'
	| 'internet'
	| 'device'
	| 'webcam'
	| 'headset'
	| 'mouse';

interface Props {
	name: OfferIconName;
	size?: number;
}

const { name, size = 48 } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 32 32"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'one-on-one' && (
			<g>
				<circle cx="11" cy="12" r="4.2" fill="#7d9274" />
				<rect x="5.2" y="18.2" width="11.6" height="7" rx="3.5" fill="#7d9274" />
				<circle cx="21" cy="12" r="4.2" fill="#d77950" />
				<rect x="15.2" y="18.2" width="11.6" height="7" rx="3.5" fill="#d77950" />
			</g>
		)
	}
	{
		name === 'remote' && (
			<g>
				<rect x="4" y="6" width="24" height="16" rx="3" fill="#7d9274" />
				<rect x="6.2" y="8.2" width="19.6" height="11.6" rx="1.5" fill="#f7f1e8" />
				<rect x="13" y="22" width="6" height="2" fill="#54465a" />
				<rect x="10" y="24" width="12" height="2.2" rx="1" fill="#54465a" />
			</g>
		)
	}
	{
		name === 'interactive' && (
			<g>
				<rect x="3" y="3" width="12" height="12" rx="2.5" fill="#7d9274" />
				<rect x="17" y="3" width="12" height="12" rx="2.5" fill="#d77950" />
				<rect x="3" y="17" width="12" height="12" rx="2.5" fill="#d77950" />
				<rect x="17" y="17" width="12" height="12" rx="2.5" fill="#7d9274" />
			</g>
		)
	}
	{
		name === 'barton' && (
			<g>
				<rect x="5" y="20" width="6" height="6" rx="1.5" fill="#7d9274" />
				<rect x="13" y="13" width="6" height="13" rx="1.5" fill="#54465a" />
				<rect x="21" y="6" width="6" height="20" rx="1.5" fill="#d77950" />
			</g>
		)
	}
	{
		name === 'weekly' && (
			<g>
				<rect x="5" y="7" width="22" height="19" rx="3" fill="#7d9274" />
				<rect x="5" y="7" width="22" height="6" rx="3" fill="#54465a" />
				<rect x="9.5" y="5" width="2.4" height="5" rx="1" fill="#d77950" />
				<rect x="20.1" y="5" width="2.4" height="5" rx="1" fill="#d77950" />
				<circle cx="12" cy="18.5" r="1.6" fill="#f7f1e8" />
				<circle cx="16" cy="18.5" r="1.6" fill="#f7f1e8" />
				<circle cx="20" cy="18.5" r="1.6" fill="#f7f1e8" />
			</g>
		)
	}
	{
		name === 'fun' && (
			<g>
				<rect x="6" y="6" width="20" height="20" rx="5" fill="#7d9274" />
				<circle cx="12.2" cy="13.2" r="1.5" fill="#f7f1e8" />
				<circle cx="19.8" cy="13.2" r="1.5" fill="#f7f1e8" />
				<path
					d="M11.2 17.4c1.3 2 8.3 2 9.6 0"
					fill="none"
					stroke="#d77950"
					stroke-width="1.8"
					stroke-linecap="round"
				/>
			</g>
		)
	}
	{
		name === 'internet' && (
			<g>
				<circle cx="16" cy="24" r="2.2" fill="#d77950" />
				<path
					d="M8.2 18.2c4.3-4.3 11.3-4.3 15.6 0"
					fill="none"
					stroke="#7d9274"
					stroke-width="2.2"
					stroke-linecap="round"
				/>
				<path
					d="M5.2 14.2c6-6 15.6-6 21.6 0"
					fill="none"
					stroke="#54465a"
					stroke-width="2.2"
					stroke-linecap="round"
				/>
				<path
					d="M2.6 10.4c7.4-7.4 19.4-7.4 26.8 0"
					fill="none"
					stroke="#7d9274"
					stroke-width="2.2"
					stroke-linecap="round"
				/>
			</g>
		)
	}
	{
		name === 'device' && (
			<g>
				<rect x="3" y="6" width="26" height="16" rx="3" fill="#7d9274" />
				<rect x="5.2" y="8.2" width="21.6" height="11.6" rx="1.5" fill="#f7f1e8" />
				<rect x="8" y="22" width="16" height="3.2" rx="1.2" fill="#54465a" />
				<rect x="12" y="23" width="8" height="1.4" rx="0.7" fill="#d77950" />
			</g>
		)
	}
	{
		name === 'webcam' && (
			<g>
				<rect x="4" y="8" width="16" height="14" rx="3" fill="#7d9274" />
				<circle cx="12" cy="15" r="3.6" fill="#f7f1e8" />
				<circle cx="12" cy="15" r="1.8" fill="#d77950" />
				<path d="M20 12.2 27.2 8.4v13.2L20 17.8z" fill="#54465a" />
			</g>
		)
	}
	{
		name === 'headset' && (
			<g>
				<path
					d="M6 16.5V14c0-5.5 4.5-10 10-10s10 4.5 10 10v2.5"
					fill="none"
					stroke="#54465a"
					stroke-width="2.4"
					stroke-linecap="round"
				/>
				<rect x="4" y="15" width="5.5" height="8" rx="2" fill="#7d9274" />
				<rect x="22.5" y="15" width="5.5" height="8" rx="2" fill="#7d9274" />
				<rect x="22.8" y="21.5" width="2.2" height="5.5" rx="1.1" fill="#d77950" />
			</g>
		)
	}
	{
		name === 'mouse' && (
			<g>
				<rect x="9" y="4" width="14" height="24" rx="7" fill="#7d9274" />
				<rect x="15.1" y="6.4" width="1.8" height="6.2" rx="0.9" fill="#f7f1e8" />
				<path d="M9 14h14" stroke="#54465a" stroke-width="1.6" />
				<circle cx="16" cy="20.5" r="2" fill="#d77950" />
			</g>
		)
	}
</svg>
