---
type OfferIconName = 'one-on-one' | 'remote' | 'interactive' | 'barton' | 'weekly' | 'fun';

interface Props {
	name: OfferIconName;
	size?: number;
}

const { name, size = 48 } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 32 32"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'one-on-one' && (
			<g>
				<circle cx="11" cy="12" r="4.2" fill="#165a54" />
				<rect x="5.2" y="18.2" width="11.6" height="7" rx="3.5" fill="#165a54" />
				<circle cx="21" cy="12" r="4.2" fill="#d4684a" />
				<rect x="15.2" y="18.2" width="11.6" height="7" rx="3.5" fill="#d4684a" />
			</g>
		)
	}
	{
		name === 'remote' && (
			<g>
				<rect x="4" y="6" width="24" height="16" rx="3" fill="#165a54" />
				<rect x="6.2" y="8.2" width="19.6" height="11.6" rx="1.5" fill="#f4efe6" />
				<rect x="13" y="22" width="6" height="2" fill="#123832" />
				<rect x="10" y="24" width="12" height="2.2" rx="1" fill="#123832" />
			</g>
		)
	}
	{
		name === 'interactive' && (
			<g>
				<rect x="3" y="3" width="12" height="12" rx="2.5" fill="#165a54" />
				<rect x="17" y="3" width="12" height="12" rx="2.5" fill="#d4684a" />
				<rect x="3" y="17" width="12" height="12" rx="2.5" fill="#d4684a" />
				<rect x="17" y="17" width="12" height="12" rx="2.5" fill="#165a54" />
			</g>
		)
	}
	{
		name === 'barton' && (
			<g>
				<rect x="5" y="20" width="6" height="6" rx="1.5" fill="#165a54" />
				<rect x="13" y="13" width="6" height="13" rx="1.5" fill="#123832" />
				<rect x="21" y="6" width="6" height="20" rx="1.5" fill="#d4684a" />
			</g>
		)
	}
	{
		name === 'weekly' && (
			<g>
				<rect x="5" y="7" width="22" height="19" rx="3" fill="#165a54" />
				<rect x="5" y="7" width="22" height="6" rx="3" fill="#123832" />
				<rect x="9.5" y="5" width="2.4" height="5" rx="1" fill="#d4684a" />
				<rect x="20.1" y="5" width="2.4" height="5" rx="1" fill="#d4684a" />
				<circle cx="12" cy="18.5" r="1.6" fill="#f4efe6" />
				<circle cx="16" cy="18.5" r="1.6" fill="#f4efe6" />
				<circle cx="20" cy="18.5" r="1.6" fill="#f4efe6" />
			</g>
		)
	}
	{
		name === 'fun' && (
			<g>
				<rect x="6" y="6" width="20" height="20" rx="5" fill="#165a54" />
				<circle cx="12.2" cy="13.2" r="1.5" fill="#f4efe6" />
				<circle cx="19.8" cy="13.2" r="1.5" fill="#f4efe6" />
				<path
					d="M11.2 17.4c1.3 2 8.3 2 9.6 0"
					fill="none"
					stroke="#d4684a"
					stroke-width="1.8"
					stroke-linecap="round"
				/>
			</g>
		)
	}
</svg>
