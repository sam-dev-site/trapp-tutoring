---
interface Props {
	size?: number;
}

const { size = 64 } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 32 32"
	role="img"
>
	<title>Trapp Tutoring logo option: word-building tiles</title>
	<rect x="2" y="16" width="9" height="9" rx="2" fill="#165a54" />
	<rect x="11.5" y="10" width="9" height="9" rx="2" fill="#f4efe6" stroke="#123832" stroke-width="1.25" />
	<rect x="13.3" y="12.1" width="5.4" height="1.8" rx="0.4" fill="#123832" />
	<rect x="15.1" y="12.1" width="1.8" height="5.4" rx="0.4" fill="#123832" />
	<rect x="21" y="16" width="9" height="9" rx="2" fill="#d4684a" />
</svg>
