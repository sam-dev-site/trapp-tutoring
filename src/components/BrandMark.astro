---
interface Props {
	href?: string;
}

const { href = import.meta.env.BASE_URL } = Astro.props;
const markSrc = `${import.meta.env.BASE_URL}images/logo/whale-clean.jpg`;
---

<a class="wordmark" href={href}>
	<img
		class="wordmark-mark"
		src={markSrc}
		alt=""
		width="48"
		height="48"
	/>
	<span>Trapp Tutoring</span>
</a>
