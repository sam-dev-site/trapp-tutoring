---
import '../styles/placeholder.css';

export type PhotoShot = 'hero' | 'about' | 'teaching' | 'session' | 'tiles';

interface Props {
	shot: PhotoShot;
}

const shots: Record<
	PhotoShot,
	{
		label: string;
		ratio: string;
		interimSrc?: string;
		interimAlt?: string;
		interimWidth?: number;
		interimHeight?: number;
		photoSrc?: string;
		photoAlt?: string;
		photoWidth?: number;
		photoHeight?: number;
		wide?: boolean;
	}
> = {
	hero: {
		label: 'Replace with: Erin hero, warm, facing camera, space around her',
		ratio: '16 / 9',
		interimSrc: 'images/logo/whale-original.jpg',
		interimAlt: 'Illustration of a whale reading a book',
		interimWidth: 1408,
		interimHeight: 768,
	},
	about: {
		label: 'Replace with: About headshot of Erin, different from the hero if possible',
		ratio: '4 / 5',
		photoSrc: 'images/erin/about-headshot.jpg',
		photoAlt: 'Erin Trapp smiling outdoors',
		photoWidth: 886,
		photoHeight: 1024,
	},
	teaching: {
		label: 'Replace with: Teaching setup — workspace / Koala Go, over-the-shoulder or at the desk',
		ratio: '16 / 9',
	},
	session: {
		label: 'Replace with: Session photo (student faces allowed with permission)',
		ratio: '4 / 3',
	},
	tiles: {
		label: 'Replace with: Close-up of letter tiles / games (no third-party logos)',
		ratio: '1024 / 684',
		photoSrc: 'images/dyslexia/letter-tiles.jpg',
		photoAlt: 'Letter tiles spelling dyslexia on a paper brain',
		photoWidth: 1024,
		photoHeight: 684,
		wide: true,
	},
};

const { shot } = Astro.props;
const {
	label,
	ratio,
	interimSrc,
	interimAlt,
	interimWidth,
	interimHeight,
	photoSrc,
	photoAlt,
	photoWidth,
	photoHeight,
	wide,
} = shots[shot];
const interimUrl = interimSrc ? `${import.meta.env.BASE_URL}${interimSrc}` : undefined;
const photoUrl = photoSrc ? `${import.meta.env.BASE_URL}${photoSrc}` : undefined;
---

{
	photoUrl ? (
		<figure class:list={['image-placeholder', 'image-placeholder-photo', { 'is-wide': wide }]}>
			<img
				src={photoUrl}
				alt={photoAlt}
				width={photoWidth}
				height={photoHeight}
				style={`aspect-ratio: ${ratio};`}
			/>
		</figure>
	) : interimUrl ? (
		<figure class="image-placeholder image-placeholder-interim">
			<img src={interimUrl} alt={interimAlt} width={interimWidth} height={interimHeight} />
			<figcaption>{label}</figcaption>
		</figure>
	) : (
		<figure class="image-placeholder">
			<div class="image-placeholder-frame" style={`aspect-ratio: ${ratio};`} role="img" aria-label={label}>
				<p>{label}</p>
			</div>
		</figure>
	)
}
