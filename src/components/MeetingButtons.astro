---
import { contactPhone, mailtoHref, smsHref, textBody } from '../data/contact';

interface Props {
	lead?: boolean;
	showCall?: boolean;
}

const { lead = true, showCall = true } = Astro.props;

const actions: { href: string; label: string; sms?: boolean }[] = [
	{ href: mailtoHref(), label: 'Email' },
	{ href: smsHref(), label: 'Text', sms: true },
];

if (showCall) {
	actions.push({ href: `tel:${contactPhone}`, label: 'Call' });
}
---

{
	lead && (
		<p>
			Please inquire for a free meeting with me to see if Trapp Tutoring may be a
			good fit for you!
		</p>
	)
}
<div class="meeting-buttons">
	{
		actions.map((action) => (
			<a
				class="meeting-button"
				href={action.href}
				data-sms-number={action.sms ? contactPhone : undefined}
				data-sms-body={action.sms ? textBody : undefined}
			>
				{action.label}
			</a>
		))
	}
</div>
